# Подключение к PostgreSQL (см. docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/keitaro_test

# Keitaro Admin API
KEITARO_BASE_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
KEITARO_API_KEY=вставьте_свой_ключ

# Обязательный префикс названий кампаний по ТЗ
CAMPAIGN_NAME_PREFIX=test_negimatjanov_

# Куда редиректит первый (гео) поток
GEO_REDIRECT_URL=https://google.com
